{% schema %}
{
  "name": "Image Grid Custom Pro",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },

    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },

    {
      "type": "range",
      "id": "max_rows",
      "label": "Max Rows (0 = unlimited)",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 0
    },

    {
      "type": "header",
      "content": "Design"
    },

    {
      "type": "range",
      "id": "gap",
      "label": "Grid Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16
    },

    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16
    },

    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "3/4", "label": "Tall (3:4)" }
      ],
      "default": "4/5"
    },

    {
      "type": "checkbox",
      "id": "hover_zoom",
      "label": "Enable Hover Zoom",
      "default": true
    }
  ],

  "blocks": [
    {
      "type": "image_block",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection Link"
        }
      ]
    }
  ],

  "max_blocks": 12,

  "presets": [
    {
      "name": "Image Grid Custom Pro"
    }
  ]
}
{% endschema %}

{% assign cols_mobile = section.settings.mobile_columns %}
{% assign cols_desktop = section.settings.desktop_columns %}
{% assign max_rows = section.settings.max_rows %}

{% if max_rows > 0 %}
  {% assign max_items = max_rows | times: cols_desktop %}
{% else %}
  {% assign max_items = section.blocks.size %}
{% endif %}

<div class="custom-grid"
     style="
      --radius: {{ section.settings.border_radius }}px;
      --gap: {{ section.settings.gap }}px;
      --aspect: {{ section.settings.aspect_ratio }};
     ">

  {% for block in section.blocks limit: max_items %}
    <a href="{{ block.settings.link }}" class="grid-item">
      {% if block.settings.image %}
        <img 
          src="{{ block.settings.image | image_url: width: 1000 }}"
          alt=""
          loading="lazy"
        >
      {% endif %}
    </a>
  {% endfor %}
</div>

<style>
.custom-grid {
  display: grid;
  grid-template-columns: repeat({{ cols_mobile }}, 1fr);
  gap: var(--gap);
}

.grid-item {
  position: relative;
  width: 100%;
  aspect-ratio: var(--aspect);
  overflow: hidden;
  border-radius: var(--radius);
  display: block;
}

.grid-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Desktop */
@media screen and (min-width: 990px) {
  .custom-grid {
    grid-template-columns: repeat({{ cols_desktop }}, 1fr);
  }
}

/* Hover Zoom */
{% if section.settings.hover_zoom %}
.grid-item img {
  transition: transform 0.4s ease;
}
.grid-item:hover img {
  transform: scale(1.05);
}
{% endif %}
</style>