<section class="static-image-grid-{{ section.id }}">
  <div class="static-image-grid-container">
    
    <div class="static-image-grid-wrapper">
      
      {% for block in section.blocks %}
        <div class="static-image-card" {{ block.shopify_attributes }}>
          
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '400,600,800,1000,1200,1600'
            }}
          {% endif %}

        </div>
      {% endfor %}

    </div>

  </div>
</section>

<style>
.static-image-grid-{{ section.id }} {
  background: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.section_padding_top }}px;
  padding-bottom: {{ section.settings.section_padding_bottom }}px;
}

.static-image-grid-{{ section.id }} .static-image-grid-container {
  max-width: {{ section.settings.desktop_container_width }}px;
  margin: 0 auto;
  width: 100%;
}

.static-image-grid-{{ section.id }} .static-image-grid-wrapper {
  display: grid;
  grid-template-columns: repeat({{ section.settings.desktop_cards }}, minmax(0, 1fr));
  gap: {{ section.settings.gap }}px;
  align-items: start;
}

.static-image-grid-{{ section.id }} .static-image-card {
  width: 100%;
}

.static-image-grid-{{ section.id }} .static-image-card img {
  width: 100%;
  height: auto;
  display: block;
}

/* MOBILE */
@media screen and (max-width: 768px) {

  .static-image-grid-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .static-image-grid-{{ section.id }} .static-image-grid-container {
    max-width: {{ section.settings.mobile_container_width }}%;
  }

  .static-image-grid-{{ section.id }} .static-image-grid-wrapper {
    grid-template-columns: repeat({{ section.settings.mobile_cards }}, minmax(0, 1fr));
    gap: {{ section.settings.mobile_gap }}px;
  }

}
</style>

{% schema %}
{
  "name": "Static Image Grid",
  "settings": [

    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "Desktop Settings"
    },

    {
      "type": "range",
      "id": "desktop_cards",
      "label": "Cards Per Row",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },

    {
      "type": "range",
      "id": "desktop_container_width",
      "label": "Section Width Desktop",
      "min": 600,
      "max": 1800,
      "step": 20,
      "default": 1400
    },

    {
      "type": "range",
      "id": "gap",
      "label": "Gap Desktop",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 16
    },

    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top Padding Desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 20
    },

    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom Padding Desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 20
    },

    {
      "type": "header",
      "content": "Mobile Settings"
    },

    {
      "type": "range",
      "id": "mobile_cards",
      "label": "Cards Per Row Mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },

    {
      "type": "range",
      "id": "mobile_container_width",
      "label": "Section Width Mobile (%)",
      "min": 70,
      "max": 100,
      "step": 1,
      "default": 100
    },

    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Gap Mobile",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 10
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Top Padding Mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 12
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Bottom Padding Mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 12
    }

  ],

  "blocks": [
    {
      "type": "image",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Static Image Grid"
    }
  ]
}
{% endschema %}