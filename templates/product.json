        "custom_liquid_8hp9Ar": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"offers-slider\">\n\n  <div class=\"offer-track\">\n\n<!-- OFFER 1 -->\n<div class=\"offer-card\">\n\n  <div class=\"offer-top\">\n\n    <h3>Buy Any 2 & Get 10% OFF</h3>\n\n    <div class=\"offer-desc\">\n\n      <div class=\"offer-icon\">✣</div>\n\n      <p>\n        Add minimum 2 items to your cart\n      </p>\n\n    </div>\n\n  </div>\n\n  <div class=\"offer-divider\"></div>\n\n  <div class=\"offer-bottom\">\n\n    <div class=\"offer-code-wrap\">\n      <span class=\"offer-label\">\n        Discount Auto Applied\n      </span>\n    </div>\n\n    <span class=\"checkout-text\">\n      Auto Applied at Checkout\n    </span>\n\n  </div>\n\n</div>\n\n<!-- OFFER 2 -->\n<div class=\"offer-card\">\n\n  <div class=\"offer-top\">\n\n    <h3>Buy Any 3 & Get 15% OFF</h3>\n\n    <div class=\"offer-desc\">\n\n      <div class=\"offer-icon\">✣</div>\n\n      <p>\n        Add minimum 3 products to your cart\n      </p>\n\n    </div>\n\n  </div>\n\n  <div class=\"offer-divider\"></div>\n\n  <div class=\"offer-bottom\">\n\n    <div class=\"offer-code-wrap\">\n      <span class=\"offer-label\">\n        Discount Auto Applied\n      </span>\n    </div>\n\n    <span class=\"checkout-text\">\n      Auto Applied at Checkout\n    </span>\n\n  </div>\n\n</div>\n\n<!-- OFFER 3 -->\n<div class=\"offer-card\">\n\n  <div class=\"offer-top\">\n\n    <h3>Extra 5% OFF on Prepaid Orders</h3>\n\n    <div class=\"offer-desc\">\n\n      <div class=\"offer-icon\">✣</div>\n\n      <p>\n        Pay online and unlock additional savings\n      </p>\n\n    </div>\n\n  </div>\n\n  <div class=\"offer-divider\"></div>\n\n  <div class=\"offer-bottom\">\n\n    <div class=\"offer-code-wrap\">\n\n      <span class=\"offer-label\">\n        Use Code\n      </span>\n\n      <button class=\"copy-btn\" data-code=\"PREPAID05\">\n\n        <span class=\"code-text\">\n          PREPAID05\n        </span>\n\n        <span class=\"copy-text\">\n          TAP TO COPY\n        </span>\n\n      </button>\n\n    </div>\n\n    <span class=\"checkout-text\">\n      Apply at Checkout\n    </span>\n\n  </div>\n\n</div>\n  </div>\n</div>\n<style>\n\n.offers-slider {\n  width: 100%;\n  overflow-x: auto;\n  overflow-y: hidden;\n\n  -webkit-overflow-scrolling: touch;\n  scrollbar-width: none;\n\n  scroll-snap-type: x mandatory;\n\n  padding-bottom: 2px;\n}\n\n.offers-slider::-webkit-scrollbar {\n  display: none;\n}\n\n.offer-track {\n  display: flex;\n  gap: 8px;\n  width: max-content;\n  padding: 2px;\n}\n\n.offer-card {\n\n  flex-shrink: 0;\n\n  background: #f7f7f7;\n\n  border: 1.5px dashed #7a7a7a;\n  border-radius: 12px;\n\n  box-sizing: border-box;\n\n  scroll-snap-align: start;\n\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n\n  padding: 10px;\n\n  /* COMPACT DEFAULT */\n  width: 270px;\n  min-width: 270px;\n\n  /* REDUCED HEIGHT */\n  aspect-ratio: 2.6 / 1;\n}\n\n.offer-top h3 {\n\n  margin: 0 0 6px;\n\n  font-size: 13px;\n  line-height: 1.25;\n\n  color: #ef3d2f;\n  font-weight: 700;\n}\n\n.offer-desc {\n  display: flex;\n  align-items: flex-start;\n  gap: 8px;\n}\n\n.offer-icon {\n\n  width: 22px;\n  height: 22px;\n  min-width: 22px;\n\n  border-radius: 50%;\n\n  background: #d5bc72;\n  color: white;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  font-size: 10px;\n\n  margin-top: 1px;\n}\n\n.offer-desc p {\n\n  margin: 0;\n\n  font-size: 10px;\n  line-height: 1.35;\n\n  color: #222;\n}\n\n.offer-divider {\n\n  border-top: 1px dashed #d9d9d9;\n\n  margin: 8px 0;\n}\n\n.offer-bottom {\n\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n\n  gap: 6px;\n}\n\n.offer-code-wrap {\n\n  display: flex;\n  align-items: center;\n\n  gap: 6px;\n}\n\n.offer-label {\n\n  font-size: 9px;\n  line-height: 1;\n\n  color: #333;\n}\n\n.copy-btn {\n\n  border: 1.5px dashed #4b83e8;\n\n  background: #edf4ff;\n\n  border-radius: 999px;\n\n  padding: 4px 8px;\n\n  display: flex;\n  align-items: center;\n  gap: 5px;\n\n  cursor: pointer;\n\n  transition: 0.2s ease;\n}\n\n.copy-btn:active {\n  transform: scale(0.96);\n}\n\n.code-text {\n\n  font-size: 10px;\n  font-weight: 700;\n\n  color: #2f67d7;\n}\n\n.copy-text {\n\n  font-size: 6px;\n  font-weight: 700;\n\n  letter-spacing: 0.4px;\n\n  color: #6d94e5;\n}\n\n.checkout-text {\n\n  font-size: 8px;\n\n  color: #8f8f8f;\n\n  line-height: 1.1;\n  text-align: right;\n}\n\n/* BIG DESKTOP */\n\n@media screen and (min-width: 1400px) {\n\n  .offer-card {\n    width: 290px;\n    min-width: 290px;\n  }\n\n}\n\n/* MEDIUM SCREENS */\n\n@media screen and (min-width: 768px) and (max-width: 1399px) {\n\n  .offer-card {\n\n    width: 250px;\n    min-width: 250px;\n\n    aspect-ratio: 2.7 / 1;\n\n    padding: 9px;\n  }\n\n}\n\n/* MOBILE */\n\n@media screen and (max-width: 767px) {\n\n  .offer-card {\n\n    width: 72vw;\n    min-width: 72vw;\n\n    max-width: 260px;\n\n    aspect-ratio: 2.5 / 1;\n\n    padding: 9px;\n  }\n\n}\n\n</style>\n\n<script>\n\ndocument.addEventListener('DOMContentLoaded', function () {\n\n  /* COPY BUTTON */\n\n  document.querySelectorAll('.copy-btn').forEach(button => {\n\n    button.addEventListener('click', function () {\n\n      const code = this.getAttribute('data-code');\n\n      navigator.clipboard.writeText(code);\n\n      const copyText = this.querySelector('.copy-text');\n\n      const originalText = copyText.innerText;\n\n      copyText.innerText = 'COPIED';\n\n      setTimeout(() => {\n\n        copyText.innerText = originalText;\n\n      }, 1500);\n\n    });\n\n  });\n\n\n\n  /* AUTO SLIDE */\n\n  const slider = document.querySelector('.offers-slider');\n  const cards = document.querySelectorAll('.offer-card');\n\n  if (!slider || cards.length === 0) return;\n\n  let currentIndex = 0;\n\n  function autoScrollCards() {\n\n    const cardWidth = cards[0].offsetWidth;\n    const gap = 8; // same as CSS gap\n\n    currentIndex++;\n\n    if (currentIndex >= cards.length) {\n      currentIndex = 0;\n    }\n\n    slider.scrollTo({\n      left: currentIndex * (cardWidth + gap),\n      behavior: 'smooth'\n    });\n\n  }\n\n  let autoSlide = setInterval(autoScrollCards, 3000);\n\n\n\n  /* PAUSE ON TOUCH / HOVER */\n\n  slider.addEventListener('mouseenter', () => {\n    clearInterval(autoSlide);\n  });\n\n  slider.addEventListener('mouseleave', () => {\n    autoSlide = setInterval(autoScrollCards, 1500);\n  });\n\n  slider.addEventListener('touchstart', () => {\n    clearInterval(autoSlide);\n  });\n\n  slider.addEventListener('touchend', () => {\n    autoSlide = setInterval(autoScrollCards, 3000);\n  });\n\n});\n\n</script>"
          }
        },
