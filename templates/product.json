            "custom_liquid": "{% comment %}\nThis code displays coupon codes stored in product metafields using Shopify's updated system.\n{% endcomment %}\n\n{% assign coupons = product.metafields.custom.coupon_codes %}\n\n{% if coupons and coupons.value.size > 0 %}\n  <div class=\"product-coupons\">\n    <h3>Available Coupons</h3>\n    <ul>\n      {% for coupon in coupons.value %}\n        <li>\n          <strong>{{ coupon }}</strong>\n          <button onclick=\"copyToClipboard('{{ coupon }}')\">Copy</button>\n        </li>\n      {% endfor %}\n    </ul>\n  </div>\n\n  <script>\n    function copyToClipboard(code) {\n      navigator.clipboard.writeText(code).then(() => {\n        alert('Coupon Code Copied: ' + code);\n      });\n    }\n  </script>\n\n  <style>\n    .product-coupons {\n      background: #f8f8f8;\n      padding: 15px;\n      border-radius: 8px;\n      margin-top: 20px;\n    }\n    .product-coupons h3 {\n      margin-bottom: 10px;\n    }\n    .product-coupons ul {\n      list-style: none;\n      padding: 0;\n    }\n    .product-coupons li {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 8px 10px;\n      background: #fff;\n      margin-bottom: 5px;\n      border-radius: 5px;\n    }\n    .product-coupons button {\n      background: #ff6600;\n      color: #fff;\n      border: none;\n      padding: 5px 10px;\n      cursor: pointer;\n      border-radius: 4px;\n    }\n    .product-coupons button:hover {\n      background: #e05500;\n    }\n  </style>\n\n{% else %}\n  <p>No coupons available for this product.</p>\n{% endif %}"
