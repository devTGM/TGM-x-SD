        "custom_liquid_t4dKcN": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% assign features = product.metafields.custom.features.value %}\n\n{% if features != blank %}\n<div class=\"features-container\">\n  {% for feature in features %}\n    {% assign remainder = forloop.index0 | modulo: 2 %}\n\n    {% if remainder == 0 %}\n      <div class=\"feature-row\">\n\n        <!-- LEFT -->\n        <div class=\"feature-col\">\n          <span class=\"tick\">✅️</span>\n          <span>{{ feature }}</span>\n        </div>\n\n        <!-- RIGHT -->\n        {% if forloop.index < features.size %}\n          <div class=\"feature-col\">\n            <span class=\"tick\">✅️</span>\n            <span>{{ features[forloop.index] }}</span>\n          </div>\n        {% endif %}\n\n      </div>\n    {% endif %}\n  {% endfor %}\n</div>\n{% endif %}\n\n<style>\n.features-container {\n  background: #fafafa;\n  padding: 16px;\n  border-radius: 22px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.feature-row {\n  display: flex;\n  justify-content: space-between;\n  background: #ffffff;\n  border-radius: 999px;\n  padding: 10px 16px;\n}\n\n.feature-col {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  width: 48%;\n}\n\n.tick {\n  color: #4CAF50;\n  font-size: 16px;\n}\n\n.feature-col span:last-child {\n  font-size: 14px;\n  color: #2a2a2a;\n}\n\n@media (max-width: 768px) {\n  .feature-row {\n    flex-direction: row; /* keep horizontal */\n    padding: 8px 12px;\n  }\n\n  .feature-col {\n    width: 50%;\n  }\n\n  .feature-col span:last-child {\n    font-size: 12px; /* slightly smaller so it fits nicely */\n  }\n\n  .tick {\n    font-size: 14px;\n  }\n}\n</style>"
          }
        },
