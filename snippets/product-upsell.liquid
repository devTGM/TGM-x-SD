{%- comment -%}
  Upsell / Frequently Bought Together snippet
  Dynamically loads complementary recommendations or collection items
{%- endcomment -%}

<div class="sdk-upsell-wrap" id="sdk-upsell-{{ product.id }}" data-product-id="{{ product.id }}">
  <div class="sdk-upsell-header">
    <div class="sdk-upsell-title">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
      <span>Frequently Bought Together</span>
    </div>
    <span class="sdk-upsell-tag">Special Bundle</span>
  </div>

  <div class="sdk-upsell-content">
    <div class="sdk-upsell-items" id="sdk-upsell-items-{{ product.id }}">
      {%- comment -%} Main Product Item (always checked) {%- endcomment -%}
      {%- assign main_variant = product.selected_or_first_available_variant -%}
      <div class="sdk-upsell-row is--main" data-product-row data-price="{{ main_variant.price }}" data-variant-id="{{ main_variant.id }}">
        <label class="sdk-upsell-checkbox-label">
          <input type="checkbox" class="sdk-upsell-ck" checked disabled data-is-main="true">
          <span class="sdk-custom-checkbox">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
        </label>
        <div class="sdk-upsell-img">
          <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" loading="lazy" width="54" height="54">
        </div>
        <div class="sdk-upsell-info">
          <div class="sdk-upsell-item-tag">This Item</div>
          <span class="sdk-upsell-item-title">{{ product.title }}</span>
          <div class="sdk-upsell-item-price">
            {%- if main_variant.compare_at_price > main_variant.price -%}
              <span class="sdk-price-sale">{{ main_variant.price | money }}</span>
              <del class="sdk-price-compare">{{ main_variant.compare_at_price | money }}</del>
            {%- else -%}
              <span class="sdk-price-regular">{{ main_variant.price | money }}</span>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- comment -%} Dynamic Complementary Products Placeholder {%- endcomment -%}
      <div class="sdk-upsell-dynamic" id="sdk-upsell-dynamic-{{ product.id }}">
        <div class="sdk-upsell-loading">
          <span class="sdk-upsell-dot"></span>
          <span class="sdk-upsell-dot"></span>
          <span class="sdk-upsell-dot"></span>
        </div>
      </div>
    </div>

    {%- comment -%} Total Bundle Action Footer {%- endcomment -%}
    <div class="sdk-upsell-footer">
      <div class="sdk-upsell-total-wrap">
        <span class="sdk-upsell-total-label">Total for selected:</span>
        <div class="sdk-upsell-total-price">
          <span class="sdk-upsell-total-amount" id="sdk-upsell-total-{{ product.id }}">{{ main_variant.price | money }}</span>
        </div>
      </div>
      <button type="button" class="sdk-upsell-btn" id="sdk-upsell-btn-{{ product.id }}">
        <span class="sdk-upsell-btn-text">Add Selected to Cart</span>
        <span class="sdk-upsell-spinner" style="display:none;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="sdk-spin"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line></svg>
        </span>
      </button>
    </div>
  </div>
</div>

<style>
/* ─── UPSELL CONTAINER ────────────────────────── */
.sdk-upsell-wrap {
  margin: 18px 0;
  background: #ffffff;
  border: 1px solid #dbe7f6;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 2px 10px rgba(60, 123, 210, 0.06);
  font-family: Poppins, Arial, sans-serif;
}

/* ─── HEADER ──────────────────────────────────── */
.sdk-upsell-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f4f8fe;
  border-bottom: 1px solid #e3eefc;
  padding: 10px 14px;
}

.sdk-upsell-title {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 11.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #1e3a6d;
}

.sdk-upsell-title svg {
  color: #3c7bd2;
}

.sdk-upsell-tag {
  font-size: 8.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background: #0b2d6a;
  color: #ffffff;
  padding: 3px 8px;
  border-radius: 60px;
}

/* ─── CONTENT & ROWS ──────────────────────────── */
.sdk-upsell-content {
  padding: 12px 14px 14px;
}

.sdk-upsell-items {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.sdk-upsell-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  background: #fafcff;
  border: 1px solid #e8f0fa;
  border-radius: 10px;
  transition: border-color 0.2s, background 0.2s;
}

.sdk-upsell-row:hover {
  border-color: #c9def8;
}

.sdk-upsell-row.is--unchecked {
  opacity: 0.55;
  background: #fdfdfd;
}

/* CHECKBOX */
.sdk-upsell-checkbox-label {
  display: inline-flex;
  align-items: center;
  cursor: pointer;
  margin: 0;
  user-select: none;
}

.sdk-upsell-ck {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.sdk-custom-checkbox {
  width: 18px;
  height: 18px;
  border: 1.5px solid #3c7bd2;
  border-radius: 5px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #3c7bd2;
  color: #fff;
  transition: all 0.15s;
}

.sdk-upsell-ck:not(:checked) + .sdk-custom-checkbox {
  background: #fff;
  border-color: #cbd5e1;
  color: transparent;
}

.sdk-upsell-ck:disabled + .sdk-custom-checkbox {
  cursor: default;
}

/* IMAGE */
.sdk-upsell-img {
  width: 48px;
  height: 48px;
  min-width: 48px;
  border-radius: 7px;
  overflow: hidden;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sdk-upsell-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* INFO */
.sdk-upsell-info {
  flex: 1;
  min-width: 0;
}

.sdk-upsell-item-tag {
  display: inline-block;
  font-size: 8px;
  font-weight: 700;
  color: #3c7bd2;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  margin-bottom: 2px;
}

.sdk-upsell-item-title {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: #222222;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sdk-upsell-item-title a {
  color: inherit;
  text-decoration: none;
}

.sdk-upsell-item-price {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 3px;
  font-size: 12px;
}

.sdk-price-sale,
.sdk-price-regular {
  font-weight: 700;
  color: #222222;
}

.sdk-price-sale {
  color: #e52d2d;
}

.sdk-price-compare {
  font-size: 11px;
  color: #888888;
}

/* LOADING STATE */
.sdk-upsell-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 12px;
}

.sdk-upsell-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #3c7bd2;
  opacity: 0.4;
  animation: sdkPulse 1.2s infinite ease-in-out;
}
.sdk-upsell-dot:nth-child(2) { animation-delay: 0.2s; }
.sdk-upsell-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes sdkPulse {
  0%, 100% { transform: scale(0.8); opacity: 0.3; }
  50% { transform: scale(1.2); opacity: 1; }
}

/* ─── FOOTER & BUTTON ─────────────────────────── */
.sdk-upsell-footer {
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px dashed #dce7f5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.sdk-upsell-total-wrap {
  display: flex;
  flex-direction: column;
}

.sdk-upsell-total-label {
  font-size: 10px;
  color: #666666;
  font-weight: 500;
}

.sdk-upsell-total-amount {
  font-size: 15px;
  font-weight: 800;
  color: #1e3a6d;
}

.sdk-upsell-btn {
  background: #3c7bd2;
  color: #ffffff;
  border: none;
  border-radius: 60px;
  padding: 8px 18px;
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: 0.3px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: background 0.2s, transform 0.15s;
}

.sdk-upsell-btn:hover {
  background: #2565c7;
}

.sdk-upsell-btn:active {
  transform: scale(0.97);
}

.sdk-spin {
  animation: sdkSpin 0.8s linear infinite;
}

@keyframes sdkSpin {
  100% { transform: rotate(360deg); }
}

@media (max-width: 480px) {
  .sdk-upsell-footer {
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
  }
  .sdk-upsell-btn {
    width: 100%;
    justify-content: center;
    padding: 10px 16px;
  }
  .sdk-upsell-total-wrap {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }
}
</style>

<script>
(function() {
  var wrap = document.getElementById('sdk-upsell-{{ product.id }}');
  if (!wrap) return;

  var productId = wrap.getAttribute('data-product-id');
  var dynamicContainer = document.getElementById('sdk-upsell-dynamic-{{ product.id }}');
  var totalEl = document.getElementById('sdk-upsell-total-{{ product.id }}');
  var btn = document.getElementById('sdk-upsell-btn-{{ product.id }}');

  // Format money helper
  function formatMoney(cents) {
    return '₹' + (cents / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  // Recalculate total price
  function updateTotal() {
    var rows = wrap.querySelectorAll('[data-product-row]');
    var total = 0;
    rows.forEach(function(row) {
      var ck = row.querySelector('.sdk-upsell-ck');
      if (ck && ck.checked) {
        var p = parseFloat(row.getAttribute('data-price')) || 0;
        total += p;
        row.classList.remove('is--unchecked');
      } else {
        row.classList.add('is--unchecked');
      }
    });
    totalEl.textContent = formatMoney(total);
  }

  // Fetch dynamic complementary product recommendations
  var recUrl = '/recommendations/products.json?product_id=' + productId + '&limit=2';
  fetch(recUrl)
    .then(function(res) { return res.json(); })
    .then(function(data) {
      dynamicContainer.innerHTML = '';
      if (!data || !data.products || data.products.length === 0) {
        // Fallback: If no direct AI recommendations, pull from the same collection
        {%- if product.collections.size > 0 -%}
          var collUrl = '{{ product.collections.first.url }}/products.json?limit=4';
          fetch(collUrl)
            .then(function(r) { return r.json(); })
            .then(function(cData) {
              if (cData && cData.products) {
                var filtered = cData.products.filter(function(p) { return p.id !== parseInt(productId, 10); }).slice(0, 2);
                renderItems(filtered);
              }
            }).catch(function() {});
        {%- endif -%}
        return;
      }
      renderItems(data.products);
    })
    .catch(function() {
      dynamicContainer.innerHTML = '';
    });

  function renderItems(products) {
    if (!products || products.length === 0) return;

    products.forEach(function(p) {
      var variant = p.variants ? p.variants[0] : null;
      if (!variant) return;

      var img = p.featured_image || (p.images && p.images[0]) || '';
      var priceFormatted = formatMoney(variant.price);
      var compareFormatted = variant.compare_at_price > variant.price ? formatMoney(variant.compare_at_price) : '';

      var row = document.createElement('div');
      row.className = 'sdk-upsell-row';
      row.setAttribute('data-product-row', '');
      row.setAttribute('data-price', variant.price);
      row.setAttribute('data-variant-id', variant.id);

      row.innerHTML =
        '<label class="sdk-upsell-checkbox-label">' +
          '<input type="checkbox" class="sdk-upsell-ck" checked>' +
          '<span class="sdk-custom-checkbox">' +
            '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>' +
          '</span>' +
        '</label>' +
        '<div class="sdk-upsell-img">' +
          (img ? '<img src="' + img + '" alt="' + (p.title || '') + '" loading="lazy" width="54" height="54">' : '') +
        '</div>' +
        '<div class="sdk-upsell-info">' +
          '<span class="sdk-upsell-item-title"><a href="' + p.url + '" target="_blank">' + p.title + '</a></span>' +
          '<div class="sdk-upsell-item-price">' +
            '<span class="sdk-price-regular">' + priceFormatted + '</span>' +
            (compareFormatted ? '<del class="sdk-price-compare">' + compareFormatted + '</del>' : '') +
          '</div>' +
        '</div>';

      var ck = row.querySelector('.sdk-upsell-ck');
      ck.addEventListener('change', updateTotal);

      dynamicContainer.appendChild(row);
    });

    updateTotal();
  }

  // Handle Add Selected to Cart
  btn.addEventListener('click', function(e) {
    e.preventDefault();
    var checkedRows = wrap.querySelectorAll('[data-product-row]');
    var itemsToAdd = [];

    checkedRows.forEach(function(row) {
      var ck = row.querySelector('.sdk-upsell-ck');
      if (ck && ck.checked) {
        var vId = row.getAttribute('data-variant-id');
        if (vId) {
          itemsToAdd.push({ id: parseInt(vId, 10), quantity: 1 });
        }
      }
    });

    if (itemsToAdd.length === 0) return;

    var btnText = btn.querySelector('.sdk-upsell-btn-text');
    var spinner = btn.querySelector('.sdk-upsell-spinner');
    btnText.style.display = 'none';
    spinner.style.display = 'inline-block';
    btn.disabled = true;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: itemsToAdd })
    })
    .then(function(res) { return res.json(); })
    .then(function() {
      btnText.textContent = '✓ Added to Cart!';
      btnText.style.display = 'inline-block';
      spinner.style.display = 'none';

      // Trigger Shopify / Theme Cart Refresh
      document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      document.documentElement.dispatchEvent(new CustomEvent('t4s:cart:refresh', { bubbles: true }));
      if (window.theme && window.theme.cart && typeof window.theme.cart.getCart === 'function') {
        window.theme.cart.getCart();
      }

      setTimeout(function() {
        btnText.textContent = 'Add Selected to Cart';
        btn.disabled = false;
      }, 2500);
    })
    .catch(function() {
      btnText.textContent = 'Add Selected to Cart';
      btnText.style.display = 'inline-block';
      spinner.style.display = 'none';
      btn.disabled = false;
    });
  });

})();
</script>
