<div class="sd-share-container">
  <span class="sd-share-label">Share:</span>
  <div class="sd-share-button-group">
    <!-- Facebook -->
    <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: product.url | url_encode }}" 
       target="_blank" 
       rel="noopener noreferrer" 
       class="sd-share-circle-btn" 
       title="Share on Facebook" 
       aria-label="Share on Facebook">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
      </svg>
    </a>

    <!-- X (Twitter) -->
    <a href="https://twitter.com/intent/tweet?url={{ shop.url | append: product.url | url_encode }}&text={{ product.title | url_encode }}" 
       target="_blank" 
       rel="noopener noreferrer" 
       class="sd-share-circle-btn" 
       title="Share on X" 
       aria-label="Share on X">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
    </a>

    <!-- Share / Copy Link -->
    <button type="button" 
            class="sd-share-circle-btn sd-share-link-btn" 
            onclick="handleSDShareClick(this)" 
            title="Share or Copy Link" 
            aria-label="Share or Copy Link" 
            data-url="{{ shop.url | append: product.url }}">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="19" x2="12" y2="5"></line>
        <polyline points="5 12 12 5 19 12"></polyline>
      </svg>
      <span class="sd-share-copied-bubble">Copied!</span>
    </button>

    <!-- WhatsApp -->
    <a href="https://api.whatsapp.com/send?text={{ product.title | url_encode }}%20{{ shop.url | append: product.url | url_encode }}" 
       target="_blank" 
       rel="noopener noreferrer" 
       class="sd-share-circle-btn" 
       title="Share on WhatsApp" 
       aria-label="Share on WhatsApp">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
    </a>

    <!-- Email -->
    <a href="mailto:?subject={{ product.title | url_encode }}&body={{ shop.url | append: product.url | url_encode }}" 
       class="sd-share-circle-btn" 
       title="Share via Email" 
       aria-label="Share via Email">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
    </a>
  </div>
</div>

<style>
.sd-share-container {
  display: flex;
  align-items: center;
  gap: 16px;
  margin: 10px 0 !important;
  padding: 12px 16px;
  background: #ffffff;
  border: 1px solid #e8e8e8;
  border-radius: 12px;
}

.sd-share-label {
  font-size: 15px;
  font-weight: 600;
  color: #222222;
  letter-spacing: 0.2px;
  font-family: inherit;
  flex-shrink: 0;
}

.sd-share-button-group {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.sd-share-circle-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid #e0e0e0;
  background: #fafafa;
  color: #222222;
  position: relative;
  text-decoration: none;
  cursor: pointer;
  padding: 0;
  outline: none;
  transition: all 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-shadow: 0 1px 2px rgba(0,0,0,0.04);
}

.sd-share-circle-btn:hover {
  background: #0b2d6a;
  border-color: #0b2d6a;
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 4px 10px rgba(11, 45, 106, 0.2);
}

.sd-share-circle-btn svg {
  transition: transform 0.2s ease;
}

.sd-share-circle-btn:hover svg {
  transform: scale(1.08);
}

.sd-share-copied-bubble {
  display: none;
  position: absolute;
  top: -30px;
  left: 50%;
  transform: translateX(-50%);
  background-color: #0b2d6a;
  color: #ffffff;
  font-size: 11px;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: 4px;
  white-space: nowrap;
  pointer-events: none;
  box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  z-index: 10;
}

.sd-share-copied-bubble::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  margin-left: -4px;
  border-width: 4px;
  border-style: solid;
  border-color: #0b2d6a transparent transparent transparent;
}

.sd-share-circle-btn.is-copied .sd-share-copied-bubble {
  display: block;
  animation: sdBubbleFade 0.2s ease-out;
}

@keyframes sdBubbleFade {
  from { opacity: 0; transform: translate(-50%, 4px); }
  to { opacity: 1; transform: translate(-50%, 0); }
}

@media (max-width: 480px) {
  .sd-share-container {
    padding: 10px 14px;
    gap: 12px;
  }
  .sd-share-circle-btn {
    width: 34px;
    height: 34px;
  }
}
</style>

<script>
function handleSDShareClick(btn) {
  const url = btn.getAttribute('data-url') || window.location.href;
  if (navigator.share) {
    navigator.share({ title: document.title, url: url }).catch(() => copyLink());
  } else {
    copyLink();
  }
  function copyLink() {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(showCopied).catch(() => fallbackCopy(url));
    } else {
      fallbackCopy(url);
    }
  }
  function showCopied() {
    btn.classList.add('is-copied');
    setTimeout(() => {
      btn.classList.remove('is-copied');
    }, 2000);
  }
  function fallbackCopy(text) {
    const tempInput = document.createElement('input');
    tempInput.value = text;
    document.body.appendChild(tempInput);
    tempInput.select();
    try {
      document.execCommand('copy');
      showCopied();
    } catch (e) {}
    document.body.removeChild(tempInput);
  }
}
</script>
