<!-- Bundle Builder Client-side Engine -->
<script>
(function() {
  const root = document.getElementById('tgm-bundle-builder-root');
  if (!root) return;

  const TARGET_QTY = parseInt(root.dataset.targetQty, 10) || 3;
  const TARGET_PRICE = parseFloat(root.dataset.targetPrice) || 1999;
  const DISCOUNT_CODE = root.dataset.discountCode || 'ANY31999';
  const CURRENCY = root.dataset.currencySym || '₹';

  // State
  let bundleItems = []; // Array of { productId, variantId, title, variantTitle, price, comparePrice, imageThumb }

  // DOM Elements
  const stepperMsg = document.getElementById('tgm-bb-stepper-msg');
  const stepperCounter = document.getElementById('tgm-bb-stepper-counter');
  const progressBarFill = document.getElementById('tgm-bb-progress-bar-fill');
  const milestones = root.querySelectorAll('.tgm-bb-milestone');
  const trackerStatusText = document.getElementById('tgm-bb-tracker-status-text');
  const trackerProgressFill = document.getElementById('tgm-bb-tracker-progress-fill');
  const trackerMrp = document.getElementById('tgm-bb-tracker-mrp');
  const trackerSave = document.getElementById('tgm-bb-tracker-save');
  const checkoutBtn = document.getElementById('tgm-bb-checkout-btn');
  const checkoutBtnText = checkoutBtn.querySelector('.tgm-bb-checkout-btn-text');
  const searchInput = document.getElementById('tgm-bb-search-input');
  const searchClear = document.getElementById('tgm-bb-search-clear');
  const sortSelect = document.getElementById('tgm-bb-sort-select');
  const tabButtons = root.querySelectorAll('.tgm-bb-tab-btn');
  const productCards = root.querySelectorAll('.tgm-bb-card');
  const visibleCountEl = document.getElementById('tgm-bb-visible-count');

  // 1. Sync & Update UI based on bundleItems
  function updateBundleUI() {
    const count = bundleItems.length;
    const remaining = Math.max(0, TARGET_QTY - count);
    const pct = Math.min(100, Math.round((count / TARGET_QTY) * 100));

    // Progress fills
    if (progressBarFill) progressBarFill.style.width = pct + '%';
    if (trackerProgressFill) trackerProgressFill.style.width = pct + '%';

    // Stepper counter text
    if (stepperCounter) stepperCounter.textContent = count + ' of ' + TARGET_QTY + ' Added';

    // Milestones
    milestones.forEach((m, idx) => {
      const stepNum = idx + 1;
      m.classList.remove('is-active', 'is-done');
      if (count >= stepNum) {
        m.classList.add('is-done');
      } else if (count + 1 === stepNum) {
        m.classList.add('is-active');
      }
    });

    // Header & Tracker messages
    if (count >= TARGET_QTY) {
      if (stepperMsg) stepperMsg.innerHTML = '🎉 <strong>Bundle Unlocked!</strong> You get any ' + TARGET_QTY + ' pieces for <strong>' + CURRENCY + TARGET_PRICE.toLocaleString('en-IN') + '</strong>!';
      if (trackerStatusText) trackerStatusText.innerHTML = '🎉 <strong>Deal Unlocked!</strong> Any ' + TARGET_QTY + ' for <strong>' + CURRENCY + TARGET_PRICE.toLocaleString('en-IN') + '</strong>';
      
      checkoutBtn.disabled = false;
      checkoutBtn.classList.remove('is-disabled');
      if (checkoutBtnText) checkoutBtnText.textContent = 'CLAIM DEAL (' + CURRENCY + TARGET_PRICE.toLocaleString('en-IN') + ')';
    } else {
      if (stepperMsg) stepperMsg.innerHTML = 'Select <strong>' + remaining + '</strong> more item' + (remaining > 1 ? 's' : '') + ' to unlock the <strong>' + CURRENCY + TARGET_PRICE.toLocaleString('en-IN') + '</strong> bundle';
      if (trackerStatusText) trackerStatusText.innerHTML = 'Add <strong>' + remaining + '</strong> more piece' + (remaining > 1 ? 's' : '') + ' to unlock <strong>' + CURRENCY + TARGET_PRICE.toLocaleString('en-IN') + '</strong>';
      
      checkoutBtn.disabled = true;
      checkoutBtn.classList.add('is-disabled');
      if (checkoutBtnText) checkoutBtnText.textContent = 'ADD ' + remaining + ' MORE TO UNLOCK';
    }

    // Slots rendering
    for (let i = 1; i <= TARGET_QTY; i++) {
      const slotEl = document.getElementById('tgm-bb-slot-' + i);
      if (!slotEl) continue;
      const item = bundleItems[i - 1];

      if (item) {
        slotEl.className = 'tgm-bb-slot is-filled';
        slotEl.innerHTML = `
          <img src="${item.imageThumb}" alt="${item.title}" title="${item.title}">
          <button type="button" class="tgm-bb-slot-remove" data-index="${i - 1}" title="Remove item">&times;</button>
        `;
      } else {
        slotEl.className = 'tgm-bb-slot is-empty';
        slotEl.innerHTML = `
          <div class="tgm-bb-slot-inner">
            <span class="tgm-bb-slot-icon">+</span>
            <span class="tgm-bb-slot-label">Item ${i}</span>
          </div>
        `;
      }
    }

    // Pricing calculation
    let totalOriginalPrice = 0;
    bundleItems.forEach(it => {
      totalOriginalPrice += (it.comparePrice && it.comparePrice > it.price ? it.comparePrice : it.price);
    });
    const formattedMrp = totalOriginalPrice > 9999 ? Math.round(totalOriginalPrice / 100) : Math.round(totalOriginalPrice);
    if (trackerMrp) trackerMrp.textContent = CURRENCY + formattedMrp.toLocaleString('en-IN');

    if (count >= TARGET_QTY) {
      const savings = Math.max(0, formattedMrp - TARGET_PRICE);
      if (trackerSave) {
        trackerSave.textContent = 'Save ' + CURRENCY + savings.toLocaleString('en-IN');
        trackerSave.style.display = 'inline-block';
      }
    } else {
      if (trackerSave) trackerSave.style.display = 'none';
    }

    // Card selected states
    productCards.forEach(card => {
      const pId = card.dataset.productId;
      const isSelected = bundleItems.some(it => it.productId === pId);
      const btn = card.querySelector('.tgm-bb-btn-add');
      if (isSelected) {
        card.classList.add('is-selected');
        if (btn && !btn.classList.contains('is-soldout')) {
          btn.querySelector('.tgm-bb-btn-text').textContent = 'ADDED';
          btn.querySelector('.tgm-bb-btn-icon').textContent = '✓';
        }
      } else {
        card.classList.remove('is-selected');
        if (btn && !btn.classList.contains('is-soldout')) {
          btn.querySelector('.tgm-bb-btn-text').textContent = 'ADD TO BUNDLE';
          btn.querySelector('.tgm-bb-btn-icon').textContent = '+';
        }
      }
    });

    // Update Drawer if present
    updateDrawer();
  }

  // 2. Add Item Handler
  function addItem(card) {
    if (bundleItems.length >= TARGET_QTY) {
      alert('You have already selected ' + TARGET_QTY + ' items for the ' + CURRENCY + TARGET_PRICE + ' bundle! Remove an item from the box or proceed to checkout.');
      return;
    }

    const productId = card.dataset.productId;
    const title = card.dataset.title;
    const selectEl = card.querySelector('.tgm-bb-variant-select');
    let variantId = '';
    let variantTitle = '';
    let price = parseFloat(card.dataset.price);
    let comparePrice = price;
    let imageThumb = '';

    if (selectEl) {
      if (selectEl.tagName === 'SELECT') {
        const opt = selectEl.options[selectEl.selectedIndex];
        variantId = opt.value;
        variantTitle = opt.text;
        if (opt.dataset.price) price = parseFloat(opt.dataset.price);
        if (opt.dataset.compare) comparePrice = parseFloat(opt.dataset.compare);
        if (opt.dataset.thumb) imageThumb = opt.dataset.thumb;
      } else {
        variantId = selectEl.value;
        if (selectEl.dataset.price) price = parseFloat(selectEl.dataset.price);
        if (selectEl.dataset.compare) comparePrice = parseFloat(selectEl.dataset.compare);
        if (selectEl.dataset.thumb) imageThumb = selectEl.dataset.thumb;
      }
    }

    if (!imageThumb) {
      const img = card.querySelector('.tgm-bb-img-primary');
      imageThumb = img ? img.src : '';
    }

    bundleItems.push({
      productId: productId,
      variantId: variantId,
      title: title,
      variantTitle: variantTitle,
      price: price,
      comparePrice: comparePrice,
      imageThumb: imageThumb
    });

    updateBundleUI();
  }

  // 3. Remove Item Handler
  function removeItem(index) {
    if (index >= 0 && index < bundleItems.length) {
      bundleItems.splice(index, 1);
      updateBundleUI();
    }
  }

  // Delegate click for remove buttons on slots
  document.addEventListener('click', function(e) {
    if (e.target && e.target.classList.contains('tgm-bb-slot-remove')) {
      const idx = parseInt(e.target.dataset.index, 10);
      removeItem(idx);
    }
  });

  // Delegate click for Add to Bundle buttons
  productCards.forEach(card => {
    const btn = card.querySelector('.tgm-bb-btn-add');
    if (btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const pId = card.dataset.productId;
        const existingIdx = bundleItems.findIndex(it => it.productId === pId);
        if (existingIdx !== -1) {
          removeItem(existingIdx);
        } else {
          addItem(card);
        }
      });
    }
  });

  // Variant change image preview updater
  productCards.forEach(card => {
    const sel = card.querySelector('select.tgm-bb-variant-select');
    if (sel) {
      sel.addEventListener('change', function() {
        const opt = sel.options[sel.selectedIndex];
        const primaryImg = card.querySelector('.tgm-bb-img-primary');
        if (opt.dataset.img && primaryImg) {
          primaryImg.src = opt.dataset.img;
        }
      });
    }
  });

  // 4. Category Filtering
  let activeCategory = 'all';
  let searchQuery = '';

  function filterProducts() {
    let visibleCount = 0;
    productCards.forEach(card => {
      const cat = card.dataset.category || 'other';
      const title = (card.dataset.title || '').toLowerCase();
      
      const matchesCat = (activeCategory === 'all') || (cat === activeCategory);
      const matchesSearch = (!searchQuery) || title.includes(searchQuery);

      if (matchesCat && matchesSearch) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (visibleCountEl) visibleCountEl.textContent = visibleCount;
  }

  tabButtons.forEach(btn => {
    btn.addEventListener('click', function() {
      tabButtons.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      activeCategory = btn.dataset.filter;
      filterProducts();
    });
  });

  // 5. Live Search
  if (searchInput) {
    searchInput.addEventListener('input', function() {
      searchQuery = this.value.trim().toLowerCase();
      if (searchClear) searchClear.style.display = searchQuery ? 'block' : 'none';
      filterProducts();
    });
  }
  if (searchClear) {
    searchClear.addEventListener('click', function() {
      searchInput.value = '';
      searchQuery = '';
      searchClear.style.display = 'none';
      filterProducts();
    });
  }

  // 6. Sorting
  if (sortSelect) {
    sortSelect.addEventListener('change', function() {
      const val = this.value;
      const grid = document.getElementById('tgm-bb-products-grid');
      const cardsArr = Array.from(productCards);

      cardsArr.sort((a, b) => {
        if (val === 'price-asc') {
          return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
        } else if (val === 'price-desc') {
          return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
        } else if (val === 'title-asc') {
          return a.dataset.title.localeCompare(b.dataset.title);
        }
        return 0;
      });

      cardsArr.forEach(c => grid.appendChild(c));
    });
  }

  // 7. Checkout / Add Bundle to Cart Batch Action
  if (checkoutBtn) {
    checkoutBtn.addEventListener('click', async function() {
      if (bundleItems.length < TARGET_QTY) return;

      checkoutBtn.classList.add('is-loading');
      checkoutBtn.disabled = true;

      const bundleId = 'bundle_' + Date.now();
      const itemsPayload = bundleItems.map(item => ({
        id: item.variantId,
        quantity: 1,
        properties: {
          '_bundle': 'Any 3 @ 1999',
          '_bundle_id': bundleId,
          'Bundle': 'Any 3 for ' + CURRENCY + TARGET_PRICE
        }
      }));

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ items: itemsPayload })
        });

        if (!response.ok) {
          throw new Error('Failed to add bundle to cart');
        }

        // Apply discount coupon and proceed to checkout
        if (DISCOUNT_CODE) {
          window.location.href = '/discount/' + encodeURIComponent(DISCOUNT_CODE) + '?redirect=/checkout';
        } else {
          window.location.href = '/checkout';
        }
      } catch (err) {
        console.error('Bundle add error:', err);
        alert('There was a problem adding the bundle to cart. Please try again.');
        checkoutBtn.classList.remove('is-loading');
        checkoutBtn.disabled = false;
      }
    });
  }

  // 8. Mobile Drawer helper
  const mobileDrawer = document.getElementById('tgm-bb-mobile-drawer');
  const drawerList = document.getElementById('tgm-bb-drawer-list');
  const drawerCount = document.getElementById('tgm-bb-drawer-count');
  const drawerClose = document.getElementById('tgm-bb-drawer-close');
  const drawerBackdrop = document.getElementById('tgm-bb-drawer-backdrop');

  function updateDrawer() {
    if (!drawerList) return;
    drawerList.innerHTML = '';
    if (drawerCount) drawerCount.textContent = bundleItems.length;

    if (bundleItems.length === 0) {
      drawerList.innerHTML = '<p style="text-align:center;color:#999;padding:20px;font-size:13px;">No pieces selected yet. Tap "+ ADD TO BUNDLE" on any design above!</p>';
      return;
    }

    bundleItems.forEach((it, idx) => {
      const itemEl = document.createElement('div');
      itemEl.className = 'tgm-bb-drawer-item';
      itemEl.innerHTML = `
        <img src="${it.imageThumb}" alt="${it.title}">
        <div class="tgm-bb-drawer-item-info">
          <div class="tgm-bb-drawer-item-title">${it.title}</div>
          ${it.variantTitle ? `<div class="tgm-bb-drawer-item-variant">${it.variantTitle}</div>` : ''}
        </div>
        <button type="button" class="tgm-bb-drawer-item-remove" data-index="${idx}">Remove</button>
      `;
      drawerList.appendChild(itemEl);
    });
  }

  if (drawerList) {
    drawerList.addEventListener('click', function(e) {
      if (e.target && e.target.classList.contains('tgm-bb-drawer-item-remove')) {
        const idx = parseInt(e.target.dataset.index, 10);
        removeItem(idx);
      }
    });
  }

  if (drawerClose) {
    drawerClose.addEventListener('click', function() {
      if (mobileDrawer) mobileDrawer.classList.remove('is-open');
    });
  }
  if (drawerBackdrop) {
    drawerBackdrop.addEventListener('click', function() {
      if (mobileDrawer) mobileDrawer.classList.remove('is-open');
    });
  }

  // Initialize
  updateBundleUI();
})();
</script>
