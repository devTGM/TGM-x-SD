</div>

<style>
/* ─── WRAPPER ─────────────────────────────────── */
.sdk-offers-wrap {
  width: 100%;
  background: #f5f9ff;
  border: 1px solid #d6e5f8;
  border-radius: 12px;
  padding: 12px 14px 14px;
  box-sizing: border-box;
  font-family: Poppins, Arial, sans-serif;
}

/* ─── HEADER ──────────────────────────────────── */
.sdk-offers-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.sdk-offers-title {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: #3c7bd2;
}

.sdk-offers-title svg {
  flex-shrink: 0;
  color: #3c7bd2;
}

/* ─── NAV ─────────────────────────────────────── */
.sdk-offers-nav { display: flex; gap: 5px; }

.sdk-prev,
.sdk-next {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 1.5px solid #ccdaf6;
  background: #fff;
  color: #3c7bd2;
  font-size: 17px;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: background 0.18s, border-color 0.18s;
}

.sdk-prev:hover,
.sdk-next:hover {
  background: #3c7bd2;
  border-color: #3c7bd2;
  color: #fff;
}

/* ─── SLIDER ──────────────────────────────────── */
.sdk-slider {
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  scroll-snap-type: x mandatory;
}
.sdk-slider::-webkit-scrollbar { display: none; }

.sdk-track {
  display: flex;
  gap: 0;
  width: max-content;
}

/* ─── CARD ────────────────────────────────────── */
.sdk-card {
  flex-shrink: 0;
  background: #ffffff;
  border: 1px solid #e2edfc;
  border-radius: 10px;
  padding: 10px 12px 10px;
  scroll-snap-align: start;
  display: flex;
  flex-direction: column;
  gap: 6px;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 1px 5px rgba(60, 123, 210, 0.07);
  transition: box-shadow 0.2s;
}

.sdk-card:hover {
  box-shadow: 0 3px 12px rgba(60, 123, 210, 0.13);
}

/* TAG */
.sdk-card-tag {
  display: inline-block;
  background: #0b2d6a;
  color: #fff;
  font-size: 8.5px;
  font-weight: 600;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 4px;
  align-self: flex-start;
}

/* BODY ROW */
.sdk-card-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

/* DISCOUNT NUMBER */
.sdk-discount {
  font-size: 24px;
  font-weight: 800;
  color: #222222;
  line-height: 1;
  letter-spacing: -0.5px;
}

.sdk-discount span {
  font-size: 13px;
  font-weight: 700;
  color: #3c7bd2;
  letter-spacing: 0;
}

/* AUTO BADGE */
.sdk-auto-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: #eaf2ff;
  color: #2565c7;
  border: 1.5px solid #b8d4f8;
  border-radius: 60px;
  padding: 4px 9px 4px 7px;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.3px;
  white-space: nowrap;
}

/* CODE GROUP (label + icon button) */
.sdk-code-group {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: #fff7e6;
  border: 1.5px dashed #f59e42;
  border-radius: 60px;
  padding: 4px 8px 4px 10px;
}

.sdk-code-val {
  font-size: 9.5px;
  font-weight: 800;
  color: #b45309;
  letter-spacing: 0.5px;
}

/* ICON-ONLY COPY BUTTON */
.sdk-copy-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  color: #b45309;
  line-height: 1;
  transition: transform 0.15s;
}

.sdk-copy-btn:active { transform: scale(0.85); }

/* DESCRIPTION */
.sdk-card-desc {
  margin: 0;
  font-size: 9.5px;
  line-height: 1.45;
  color: #8a8a8a;
  font-weight: 400;
}

/* ─── RESPONSIVE ──────────────────────────────── */
@media screen and (max-width: 767px) {
  .sdk-offers-wrap { padding: 10px 11px 12px; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

  var slider  = document.querySelector('.sdk-slider');
  var cards   = document.querySelectorAll('.sdk-card');
  var prevBtn = document.querySelector('.sdk-prev');
  var nextBtn = document.querySelector('.sdk-next');

  if (!slider || !cards.length) return;

  /* set each card to exactly the slider's visible width */
  function sizeCards() {
    var w = slider.offsetWidth;
    cards.forEach(function (c) { c.style.width = w + 'px'; });
  }
  sizeCards();
  window.addEventListener('resize', sizeCards);

  function cardStep() { return slider.offsetWidth; }

  nextBtn.addEventListener('click', function () {
    slider.scrollBy({ left: cardStep(), behavior: 'smooth' });
  });

  prevBtn.addEventListener('click', function () {
    slider.scrollBy({ left: -cardStep(), behavior: 'smooth' });
  });

  /* ── AUTO SLIDE ── */
  var idx = 0;
  var auto = setInterval(next, 3200);

  function next() {
    idx++;
    if (idx >= cards.length) idx = 0;
    slider.scrollTo({ left: idx * cardStep(), behavior: 'smooth' });
  }

  slider.addEventListener('mouseenter', function () { clearInterval(auto); });
  slider.addEventListener('mouseleave', function () { auto = setInterval(next, 3200); });
  slider.addEventListener('touchstart', function () { clearInterval(auto); }, { passive: true });
  slider.addEventListener('touchend',   function () { auto = setInterval(next, 3200); });

  /* ── COPY CODE ── */
  document.querySelectorAll('.sdk-copy-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var code  = btn.getAttribute('data-code');
      var iconCopy  = btn.querySelector('.sdk-icon-copy');
      var iconCheck = btn.querySelector('.sdk-icon-check');
      navigator.clipboard.writeText(code).catch(function () {});
      iconCopy.style.display  = 'none';
      iconCheck.style.display = 'block';
      setTimeout(function () {
        iconCopy.style.display  = 'block';
        iconCheck.style.display = 'none';
      }, 1800);
    });
  });

});
</script>
